<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to trigger the haptic feedback vibrator on click/right-click gestures. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Starting Shizuku without a computer: the app connects to this device's own adbd
         over loopback, which needs a socket (INTERNET) and mDNS to find the port adbd
         picked for this session (ACCESS_NETWORK_STATE). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The one-time pairing code is collected through a notification reply, because the
         system stops advertising its pairing service the moment its own dialog leaves the
         screen — an app window asking for the code would cancel what it is asking about. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Package visibility: the starter command is built from Shizuku's own install paths. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ARTouchpad">

        <!-- Single-activity app; portrait-locked so the touchpad surface stays stable. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku content provider: required by the Shizuku library to communicate with
             the Shizuku daemon. It handles the binder handshake so our app can bind
             MouseService as a shell-uid UserService without needing root. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Accessibility service used to dispatch touch gestures and detect text-field
             focus on the glasses display. Gestures require BIND_ACCESSIBILITY_SERVICE;
             configuration details are in res/xml/accessibility_service_config.xml. -->
        <service
            android:name=".TouchpadAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Collects the pairing code via a notification reply; see AdbPairingService. -->
        <service
            android:name=".adb.AdbPairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="One-time pairing with this device's own wireless debugging" />
        </service>

    </application>

</manifest>
